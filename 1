import fs from 'fs';
import { exec } from 'child_process';

  exec('zip -r script.zip . -x "node_modules/*" ".npm/*" "script.zip" "package-lock.json"', async (err) => {
    if (err) {
      return m.reply('1');
    }

    try {
      let db = await fs.readFileSync('./file.zip');
      await conn.sendMessage(
        m.chat,
        { document: db, mimetype: 'application/zip', fileName: 'file.zip' },
        { quoted: m }
      );

      fs.unlinkSync('./script.zip');
    } catch (error) {
      m.reply('2');
    }
  });
